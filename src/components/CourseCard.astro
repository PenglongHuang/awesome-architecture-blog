---
import type { Course } from '../data/courses'
import { href } from '../lib/urls'
interface Props { course: Course; index?: number }
const { course, index = 0 } = Astro.props
const url = href(`/learning/${course.slug}/`)
---
<a class="course-card" href={url}>
  <div class="course-card__body">
    <p class="course-card__kicker">项目学习 · COURSE {String(index + 1).padStart(2, '0')}</p>
    <h3>{course.title}</h3>
    <p class="course-card__sub">{course.subtitle}</p>
    <p class="course-card__desc">{course.description}</p>
    <div class="course-card__tags">
      {course.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <span class="course-card__cta">进入课程 →</span>
  </div>
  <div class="course-card__meta">
    <span><b>{course.modules}</b><small>个模块</small></span>
    <span><b>{course.minutes}</b><small>分钟</small></span>
    <span><b>{course.level}</b><small>难度</small></span>
  </div>
</a>
