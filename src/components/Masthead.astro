---
import BrandMark from './BrandMark.astro'
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname
const items = [
  { href: `${base}tutorial/`, label: '入门教程', match: '/tutorial/' },
  { href: `${base}templates/`, label: '架构地图', match: '/templates/' },
  { href: `${base}cases/`, label: '系统设计', match: '/cases/' },
  { href: `${base}learning/`, label: '项目学习', match: '/learning/' },
]
---
<header class="masthead frame">
  <div class="grid">
    <a class="masthead__brand" href={base} aria-label="AI架构师之路"><span class="masthead__mark"><BrandMark /></span><span>AI架构师之路<small>理解系统，也理解取舍。</small></span></a>
    <nav class="masthead__nav" aria-label="主导航">
      {items.map((it) => (
        <a href={it.href} aria-current={path.includes(it.match) ? 'page' : undefined}>{it.label}</a>
      ))}
    </nav>
    <div class="masthead__actions">
      <a class="nav-search" href={`${base}search/`} aria-label="搜索"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><span>搜索</span><kbd>/</kbd></a>
      <button id="theme-toggle" class="theme-toggle" data-theme-toggle type="button" aria-label="切换到暗黑主题"><span data-theme-icon aria-hidden="true">☾</span></button>
    </div>
  </div>
</header>
<script>
  import '../scripts/navigation'
</script>
