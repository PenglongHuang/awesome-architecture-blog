---
import BrandMark from './BrandMark.astro'
import LanguageSwitch from './LanguageSwitch.astro'
import { href } from '../lib/urls'
import { messagesFor, localePath, type Locale } from '../lib/i18n.mjs'
interface Props { locale?: Locale; alternates?: Partial<Record<Locale, string>> }
const { locale = 'zh-CN', alternates = {} } = Astro.props
const t = messagesFor(locale)
const path = Astro.url.pathname
const items = [
  { path: '/tutorial/', label: t.tutorials },
  { path: '/templates/', label: t.templates },
  { path: '/cases/', label: t.cases },
  { path: '/learning/', label: t.courses },
]
---
<header class="masthead frame">
  <div class="masthead__inner">
    <a class="masthead__brand" href={href(localePath('/', locale))} aria-label={t.siteName}>
      <span class="masthead__mark"><BrandMark /></span>
      <span class="masthead__wordmark"><span class="masthead__name">{t.siteName}</span><span class="masthead__short-name" aria-hidden="true">{locale === 'en' ? 'AI Architect' : t.siteName}</span><small>{t.tagline}</small></span>
    </a>
    <nav class="masthead__nav" aria-label={t.navigation}>
      {items.map(item => <a href={href(localePath(item.path, locale))} aria-current={path.startsWith(href(localePath(item.path, locale))) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="masthead__actions">
      <a class="nav-search masthead__tool" href={href(localePath('/search/', locale))} aria-label={t.search} title={`${t.search} (Ctrl/⌘ K)`}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></a>
      <LanguageSwitch locale={locale} alternates={alternates} />
      <button id="theme-toggle" class="theme-toggle masthead__tool" data-theme-toggle type="button" aria-label={locale === 'en' ? 'Choose a theme' : '选择主题风格'}><span data-theme-icon aria-hidden="true">●</span></button>
    </div>
  </div>
</header>
<script>
  import '../scripts/navigation'
</script>
