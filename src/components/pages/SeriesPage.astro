---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../PostList.astro'
import StructuredData from '../StructuredData.astro'
import { getSeries, postsInSeries, seriesHref, postHref } from '../../lib/posts'

interface Props { seriesId: string }
const { seriesId } = Astro.props
const series = getSeries(seriesId)
const all = await getCollection('posts')
const posts = postsInSeries(all, seriesId)
const seriesUrl = new URL(seriesHref(seriesId), Astro.site ?? Astro.url.origin).href
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url.origin).href
const channelUrl = new URL(`${import.meta.env.BASE_URL}${series.channel}/`, Astro.site ?? Astro.url.origin).href
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: series.title,
  description: series.description,
  url: seriesUrl,
  inLanguage: 'zh-CN',
  isPartOf: { '@type': 'WebSite', name: 'AI架构师之路', url: siteRoot },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: new URL(postHref(post), Astro.site ?? Astro.url.origin).href,
    })),
  },
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: siteRoot },
    { '@type': 'ListItem', position: 2, name: series.channel === 'tutorial' ? '入门教程' : '架构地图', item: channelUrl },
    { '@type': 'ListItem', position: 3, name: series.title, item: seriesUrl },
  ],
}
---
<BaseLayout title={series.title} description={series.description}>
  <StructuredData slot="head" data={[collectionSchema, breadcrumbSchema]} />
  <div class="page-head frame">
    <div class="grid">
      <p class="page-head__side">系列 · {posts.length} 篇</p>
      <h1 class="page-head__title">{series.title}</h1>
      <p class="page-head__intro">{series.description}</p>
      <p class="page-head__side">本专题共 {posts.length} 篇，按顺序阅读可从基础概念逐步进入设计与实践。</p>
    </div>
  </div>
  <section class="section frame">
    <div class="grid">
      <PostList posts={posts} showSeries={false} />
    </div>
  </section>
</BaseLayout>
