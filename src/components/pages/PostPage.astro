---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Toc from '../Toc.astro'
import PostNav from '../PostNav.astro'
import Comments from '../Comments.astro'
import RelatedKnowledge from '../RelatedKnowledge.astro'
import StructuredData from '../StructuredData.astro'
import type { Post } from '../../lib/posts'
import { getSeries, postsInSeries, seriesHref, postHref } from '../../lib/posts'
import { readingMinutes } from '../../lib/reading-time'

interface Props { post: Post }
const { post } = Astro.props
const { Content, headings } = await render(post)
const series = getSeries(post.data.series)
const channelLabel = series.channel === 'tutorial' ? '入门教程' : series.channel === 'templates' ? '架构地图' : '系统设计'
const showSeriesCrumb = series.title !== channelLabel && series.title !== `${channelLabel}篇`
const all = await getCollection('posts')
const siblings = postsInSeries(all, post.data.series)
const idx = siblings.findIndex((p) => p.id === post.id)
const prev = idx > 0 ? siblings[idx - 1] : undefined
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined
const date = post.data.pubDate.toISOString().slice(0, 10)
const modifiedDate = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)
const canonicalOrigin = String(import.meta.env.PUBLIC_CANONICAL_SITE || Astro.site || Astro.url.origin)
const canonicalPrefix = import.meta.env.PUBLIC_CANONICAL_BASE || import.meta.env.BASE_URL
const canonicalize = (url: string) => new URL(url.replace(import.meta.env.BASE_URL, canonicalPrefix), canonicalOrigin).href
const pageUrl = canonicalize(postHref(post))
const seriesUrl = canonicalize(seriesHref(series.id))
const siteRoot = new URL(canonicalPrefix, canonicalOrigin).href
const imagePath = post.data.cover ? post.data.cover.split('/').filter(Boolean).join('/') : 'og-default.svg'
const imageUrl = post.data.cover && (post.data.cover.startsWith('https://') || post.data.cover.startsWith('http://'))
  ? post.data.cover
  : new URL(`${canonicalPrefix}${imagePath}`, canonicalOrigin).href
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  image: [imageUrl],
  datePublished: date,
  dateModified: modifiedDate,
  inLanguage: 'zh-CN',
  articleSection: series.title,
  keywords: post.data.tags,
  isPartOf: { '@type': 'CollectionPage', name: series.title, url: seriesUrl },
  publisher: {
    '@type': 'Organization',
    name: 'AI架构师之路',
    url: siteRoot,
    logo: { '@type': 'ImageObject', url: new URL(`${canonicalPrefix}brand-mark.svg`, canonicalOrigin).href },
  },
  ...(post.data.author ? { author: { '@type': 'Person', name: post.data.author } } : {}),
  ...(post.data.editor ? { editor: { '@type': 'Person', name: post.data.editor } } : {}),
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: siteRoot },
    { '@type': 'ListItem', position: 2, name: channelLabel, item: new URL(`${canonicalPrefix}${series.channel}/`, canonicalOrigin).href },
    ...(showSeriesCrumb ? [{ '@type': 'ListItem', position: 3, name: series.title, item: seriesUrl }] : []),
    { '@type': 'ListItem', position: showSeriesCrumb ? 4 : 3, name: post.data.title, item: pageUrl },
  ],
}
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={post.data.coverAlt ?? post.data.title}
  ogType="article"
>
  <StructuredData slot="head" data={[articleSchema, breadcrumbSchema]} />
  <meta slot="head" property="article:published_time" content={date} />
  <meta slot="head" property="article:modified_time" content={modifiedDate} />
  {post.data.author && <meta slot="head" name="author" content={post.data.author} />}
  <div class="article frame">
    <article data-pagefind-body>
      <header class="article__header">
      <div class="crumb" data-pagefind-ignore>
        {channelLabel}
        {showSeriesCrumb && (
          <>
            {' / '}
            <a href={seriesHref(series.id)}><b>{series.title}</b></a>
          </>
        )}
        {' / '}第 {post.data.order} 篇
      </div>
      <h1>{post.data.title}</h1>
      {!(post.body ?? '').trimStart().startsWith('>') && <p class="dek">{post.data.description}</p>}
      <div class="article__meta" data-pagefind-ignore>
        <time datetime={date}>{date}</time>
        {post.data.updatedDate && post.data.updatedDate.toISOString().slice(0, 10) !== date && <span>更新于 {modifiedDate}</span>}
        {post.data.author && <span>作者 {post.data.author}</span>}
        {post.data.editor && <span>编辑 {post.data.editor}</span>}
        <span>约 {readingMinutes(post.body ?? '')} 分钟阅读</span>
        <span>系列 {post.data.order} / {siblings.length}</span>
      </div>
      <div class="reading-controls" data-pagefind-ignore><button type="button" data-reading-size aria-pressed="false">大字阅读</button><button type="button" data-reading-focus aria-pressed="false">专注阅读</button></div>
      </header>
      <details class="toc-mobile" data-pagefind-ignore><summary>本页目录</summary><Toc headings={headings} /></details>
      <div class="prose"><Content /></div>
      <RelatedKnowledge post={post} allPosts={all} />
      <PostNav prev={prev} next={next} />
      <Comments />
    </article>
    <div class="toc-desktop"><Toc headings={headings} /></div>
  </div>
</BaseLayout>
<script>
  import '../../scripts/reading'
</script>
