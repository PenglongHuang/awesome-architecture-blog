---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Toc from '../Toc.astro'
import PostNav from '../PostNav.astro'
import Comments from '../Comments.astro'
import RelatedKnowledge from '../RelatedKnowledge.astro'
import StructuredData from '../StructuredData.astro'
import type { Post } from '../../lib/posts'
import { getSeries, postsInSeries, seriesHref, postHref, postAlternates, postsForLocale } from '../../lib/posts'
import { messagesFor, localePath } from '../../lib/i18n.mjs'
import { CHANNELS } from '../../data/series'
import { canonicalUrl, href } from '../../lib/urls'
import { readingMinutes } from '../../lib/reading-time'

interface Props { post: Post }
const { post } = Astro.props
const { Content, headings } = await render(post)
const locale = post.data.locale
const t = messagesFor(locale)
const series = getSeries(post.data.series, locale)
const channelLabel = locale === 'en' ? (series.channel === 'tutorial' ? t.tutorials : t[series.channel]) : CHANNELS[series.channel].title
const entryLabel = post.data.kind === 'tutorial' ? 'Chapter' : post.data.kind === 'template' ? 'Map' : 'Case'
const showSeriesCrumb = series.title !== channelLabel && series.title !== `${channelLabel}篇`
const collection = await getCollection('posts')
const alternates = postAlternates(post, collection)
const all = postsForLocale(collection, locale)
const siblings = postsInSeries(all, post.data.series, locale)
const idx = siblings.findIndex((p) => p.id === post.id)
const prev = idx > 0 ? siblings[idx - 1] : undefined
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined
const date = post.data.pubDate.toISOString().slice(0, 10)
const modifiedDate = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10)
const pageUrl = canonicalUrl(postHref(post))
const seriesUrl = canonicalUrl(seriesHref(series.id, locale))
const siteRoot = canonicalUrl(localePath('/', locale))
const imageUrl = post.data.cover && /^https?:\/\//.test(post.data.cover)
  ? post.data.cover : canonicalUrl(post.data.cover || t.ogImage)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  image: [imageUrl],
  datePublished: date,
  dateModified: modifiedDate,
  inLanguage: locale,
  articleSection: series.title,
  keywords: post.data.tags,
  isPartOf: { '@type': 'CollectionPage', name: series.title, url: seriesUrl },
  publisher: {
    '@type': 'Organization',
    '@id': `${canonicalUrl('/')}#organization`,
    name: t.siteName,
    url: siteRoot,
    logo: { '@type': 'ImageObject', url: canonicalUrl('brand-mark.svg') },
  },
  ...(post.data.author ? { author: { '@type': 'Person', name: post.data.author } } : {}),
  ...(post.data.editor ? { editor: { '@type': 'Person', name: post.data.editor } } : {}),
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: siteRoot },
    { '@type': 'ListItem', position: 2, name: channelLabel, item: canonicalUrl(localePath(`/${series.channel}/`, locale)) },
    ...(showSeriesCrumb ? [{ '@type': 'ListItem', position: 3, name: series.title, item: seriesUrl }] : []),
    { '@type': 'ListItem', position: showSeriesCrumb ? 4 : 3, name: post.data.title, item: pageUrl },
  ],
}
---
<BaseLayout
  locale={locale}
  alternates={alternates}
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={post.data.coverAlt ?? post.data.title}
  ogType="article"
>
  <StructuredData slot="head" data={[articleSchema, breadcrumbSchema]} />
  <meta slot="head" property="article:published_time" content={date} />
  <meta slot="head" property="article:modified_time" content={modifiedDate} />
  {post.data.author && <meta slot="head" name="author" content={post.data.author} />}
  <div class="article frame">
    <article data-pagefind-body>
      <header class="article__header">
      <div class="crumb" data-pagefind-ignore>
        {channelLabel}
        {showSeriesCrumb && (
          <>
            {' / '}
            <a href={seriesHref(series.id, locale)}><b>{series.title}</b></a>
          </>
        )}
        {' / '}{locale === 'en' ? `${entryLabel} ${post.data.order}` : `第 ${post.data.order} 篇`}
      </div>
      <h1>{post.data.title}</h1>
      {!alternates.en && locale === 'zh-CN' && <p class="translation-note" data-pagefind-ignore>本文暂无英文版。<a href={href('/en/tutorial/')}>浏览英文站</a></p>}
      {!(post.body ?? '').trimStart().startsWith('>') && <p class="dek">{post.data.description}</p>}
      <div class="article__meta" data-pagefind-ignore>
        <time datetime={date}>{date}</time>
        {post.data.updatedDate && post.data.updatedDate.toISOString().slice(0, 10) !== date && <span>{t.updated} {modifiedDate}</span>}
        {post.data.author && <span>{t.author} {post.data.author}</span>}
        {post.data.editor && <span>{t.editor} {post.data.editor}</span>}
        <span>{locale === 'en' ? `${readingMinutes(post.body ?? '', locale)} min read` : `约 ${readingMinutes(post.body ?? '', locale)} 分钟阅读`}</span>
        <span>{t.series} {post.data.order} / {siblings.length}</span>
      </div>
      <div class="reading-controls" data-pagefind-ignore><button type="button" data-reading-size aria-pressed="false">{t.largeText}</button><button type="button" data-reading-focus aria-pressed="false">{t.focus}</button></div>
      </header>
      <details class="toc-mobile" data-pagefind-ignore><summary>{t.contents}</summary><Toc headings={headings} locale={locale} /></details>
      <div class="prose"><Content /></div>
      <RelatedKnowledge post={post} allPosts={all} />
      <PostNav prev={prev} next={next} locale={locale} />
      <Comments locale={locale} />
    </article>
    <div class="toc-desktop"><Toc headings={headings} locale={locale} /></div>
  </div>
</BaseLayout>
<script>
  import '../../scripts/reading'
</script>
