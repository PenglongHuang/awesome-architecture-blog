---
import { messagesFor, type Locale } from '../lib/i18n.mjs'
import type { Post } from '../lib/posts'
import { postHref } from '../lib/posts'
interface Props { locale?: Locale; prev?: Post; next?: Post }
const t = messagesFor(Astro.props.locale)
const { prev, next } = Astro.props
---
<div class="nav-pair" data-pagefind-ignore>
  <div>{prev && <a href={postHref(prev)}><small>{t.previous}</small>{prev.data.title}</a>}</div>
  <div style="text-align:right">{next && <a href={postHref(next)}><small>{t.next}</small>{next.data.title}</a>}</div>
</div>
