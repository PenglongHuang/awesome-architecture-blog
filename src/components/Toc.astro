---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const items = Astro.props.headings.filter((h) => h.depth === 2)
---
{items.length > 0 && (
  <aside class="toc" data-pagefind-ignore>
    <b>本页目录</b>
    {items.map((h) => <div><a href={`#${h.slug}`}>{h.text}</a></div>)}
  </aside>
)}
