---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import BrandMark from '../components/BrandMark.astro'
import CourseCard from '../components/CourseCard.astro'
import { SERIES } from '../data/series'
import { COURSES } from '../data/courses'
import { sortByDateDesc, postHref, getSeries, seriesHref, postsInSeries } from '../lib/posts'
import { readingMinutes } from '../lib/reading-time'
import { href } from '../lib/urls'

const all = await getCollection('posts')
const recent = sortByDateDesc(all).slice(0, 4)
const first = postsInSeries(all, 'foundations')[0]
const firstHref = first ? postHref(first) : href('/tutorial/')
const countTutorial = all.filter(p => p.data.kind === 'tutorial').length
const countTemplates = all.filter(p => p.data.kind === 'template').length
const countCases = all.filter(p => p.data.kind === 'case').length
const tutorialSeries = SERIES.filter(s => s.channel === 'tutorial').sort((a,b) => a.order-b.order)
const channels = [
  { title: '入门教程', desc: '建立思考系统的方式。', count: `${countTutorial} 篇教程`, path: '/tutorial/', icon: 'book' },
  { title: '架构地图', desc: '看懂真实系统的组织。', count: `${countTemplates} 张地图`, path: '/templates/', icon: 'layers' },
  { title: '系统设计', desc: '从真实约束走向取舍。', count: `${countCases} 个案例`, path: '/cases/', icon: 'compass' },
]
---
<BaseLayout title="AI架构师之路">
  <div class="home frame">
    <section class="home-hero" aria-label="AI架构师之路">
      <div class="home-hero__copy">
        <p class="home-hero__intro"><span aria-hidden="true"></span> 一份持续生长的架构阅读集</p>
        <h1>先看清系统，<br />再动手写代码。</h1>
        <p class="home-hero__description">给已经会写代码，正在学着判断系统的人。<br class="desktop-break" />在阅读、拆解和实践中，建立自己的判断力。</p>
        <div class="home-hero__actions"><a class="button" href={firstHref}>从第一章开始 <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#knowledge">探索知识库 <span aria-hidden="true">↓</span></a></div>
      </div>
      <a class="reading-object" href={firstHref} aria-label="阅读第一章：为什么先有架构思维">
        <span class="reading-object__back" aria-hidden="true"></span>
        <span class="reading-object__cover">
          <span class="reading-object__edition">架构师之路 <span>阅读集</span></span>
          <BrandMark class="reading-object__symbol" />
          <strong>理解复杂，<br />做出判断。</strong>
          <span class="reading-object__foot">从一个好问题开始 <span aria-hidden="true">↗</span></span>
        </span>
        <span class="reading-object__label" aria-hidden="true"><span>打开新的视角</span><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </section>

    <section class="knowledge" id="knowledge" aria-label="探索知识库">
      {channels.map(c => <a class="knowledge-card" href={href(c.path)}>
        <span class="knowledge-card__icon" aria-hidden="true">
          {c.icon==='book' ? <svg viewBox="0 0 24 24" fill="none"><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1m0-15c3-2 6-2 9-1v15c-3-1-6-1-9 1V5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg> : c.icon==='layers' ? <svg viewBox="0 0 24 24" fill="none"><path d="m3 8 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 18l9 5 9-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg> : <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="m16 8-2 6-6 2 2-6 6-2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>}
        </span>
        <div><h2>{c.title}</h2><p>{c.desc}</p></div><span class="knowledge-card__count">{c.count}<span aria-hidden="true">↗</span></span>
      </a>)}
    </section>

    <div class="home-reading-grid">
      <section class="home-feature" aria-labelledby="featured-title">
        <div class="section-heading"><h2 id="featured-title">从这里读起</h2><span class="section-note">给判断力一个起点</span></div>
        <a class="featured-story" href={firstHref}>
          <span class="pill">入门篇 · 第一章</span><h3>{first?.data.title.replace(/^\d+\s*·\s*/, '') ?? '为什么先有架构思维'}</h3>
          <p>当 AI 能够熟练地写出代码，决定该写什么、系统该长什么样，变得越来越重要。先从这个问题开始。</p>
          <div class="story-meta"><span>{first ? `约 ${readingMinutes(first.body ?? '')} 分钟阅读` : '入门阅读'}</span><span>打开文章 <span aria-hidden="true">↗</span></span></div>
        </a>
      </section>
      <aside class="home-series" aria-labelledby="series-title"><div class="section-heading"><h2 id="series-title">按系列探索</h2><a href={href('/tutorial/')} aria-label="查看全部教程系列">全部 <span aria-hidden="true">↗</span></a></div>
        {tutorialSeries.slice(0,4).map(s => <a class="series-shortcut" href={seriesHref(s.id)}><span><strong>{s.title}</strong><small>{all.filter(p=>p.data.series===s.id).length} 篇文章</small></span><span aria-hidden="true">↗</span></a>)}
      </aside>
    </div>

    <section class="home-courses" aria-labelledby="course-title"><div class="section-heading"><div><h2 id="course-title">走进真实项目</h2><p>沿着源码，把架构理解得再深一点。</p></div><a class="quiet-link" href={href('/learning/')}>全部课程 <span aria-hidden="true">↗</span></a></div><div class="course-grid">{COURSES.map(course => <CourseCard course={course} />)}</div></section>

    <section class="home-recent" aria-labelledby="recent-title"><div class="section-heading"><h2 id="recent-title">最近更新</h2><span class="section-note">保持好奇，持续思考</span></div><div class="recent-stories">{recent.map(p => <a class="recent-story" href={postHref(p)}><span class="pill">{getSeries(p.data.series).title}</span><h3>{p.data.title.replace(/^(案例\s*)?\d+\s*·\s*/, '')}</h3><p>{p.data.description}</p><div class="story-meta"><time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0,10)}</time><span aria-hidden="true">↗</span></div></a>)}</div></section>

  </div>
</BaseLayout>
