---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="搜索">
  <link
    slot="head"
    rel="modulepreload"
    href={`${import.meta.env.BASE_URL}_pagefind/pagefind.js`}
  />
  <div class="page-head frame">
    <div class="grid">
      <p class="page-head__side">全站全文检索</p>
      <h1 class="page-head__title">搜索</h1>
      <p class="page-head__intro">试试「一致性」「抢票」「RAG」。</p>
    </div>
  </div>
  <section class="section frame">
    <div class="grid">
      <div style="grid-column: 1 / 13;">
        <form class="search-form" id="search-form">
          <input id="search-input" type="search" placeholder="试试「一致性」「抢票」「RAG」" autofocus />
          <button class="button" type="submit">搜索</button>
        </form>
        <p id="search-status" class="dek">正在加载索引…</p>
        <div id="search-results"></div>
      </div>
    </div>
  </section>

  <script>
    const base = import.meta.env.BASE_URL
    const input = document.getElementById('search-input') as HTMLInputElement
    const form = document.getElementById('search-form') as HTMLFormElement
    const results = document.getElementById('search-results')!
    const status = document.getElementById('search-status')!
    let pagefind: any
    let ready: Promise<void> | null = null
    let timer: number | undefined

    function init(): Promise<void> {
      if (!ready) {
        ready = (async () => {
          pagefind = await import(/* @vite-ignore */ `${base}_pagefind/pagefind.js`)
          await pagefind.init()
          status.textContent = '索引已就绪 · 输入 2 个以上字符开始搜索'
        })().catch((err) => {
          status.textContent = '搜索索引加载失败,请刷新重试。'
          throw err
        })
      }
      return ready
    }

    function render(hits: any[]) {
      results.replaceChildren()
      for (const hit of hits) {
        const row = document.createElement('div')
        row.className = 'search-hit'
        const heading = document.createElement('h3')
        const link = document.createElement('a')
        link.href = hit.url
        link.textContent = hit.meta?.title ?? hit.url
        heading.appendChild(link)
        const excerpt = document.createElement('p')
        excerpt.textContent = (hit.excerpt ?? '').replace(/<[^>]+>/g, '')
        row.append(heading, excerpt)
        results.appendChild(row)
      }
    }

    async function run(query: string) {
      const q = query.trim()
      if (q.length < 2) {
        results.replaceChildren()
        status.textContent = '输入 2 个以上字符开始搜索。'
        return
      }
      status.textContent = '搜索中…'
      try {
        await init()
        const search = await pagefind.search(q)
        const hits = await Promise.all(search.results.slice(0, 15).map((r: any) => r.data()))
        if (hits.length === 0) {
          results.innerHTML = '<p class="dek">没有找到结果。</p>'
          status.textContent = ''
          return
        }
        render(hits)
        status.textContent = `找到 ${hits.length} 条结果`
      } catch {
        status.textContent = '搜索失败,请稍后重试。'
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      clearTimeout(timer)
      run(input.value)
    })
    input.addEventListener('input', () => {
      clearTimeout(timer)
      timer = window.setTimeout(() => run(input.value), 250)
    })

    init()
  </script>
</BaseLayout>
