---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { postsInSeries } from '../../lib/posts'
const all = await getCollection('posts')
const posts = postsInSeries(all, 'cases')
---
<BaseLayout title="系统设计">
  <div class="page-head frame">
    <div class="grid">
      <p class="page-head__side">{posts.length} 个完整推演</p>
      <h1 class="page-head__title">把架构从答案写成推理过程</h1>
      <p class="page-head__intro">架构地图告诉你这类系统通常长什么样；系统设计告诉你，在这个具体场景里，为什么最后只能这样取舍。</p>
    </div>
  </div>
  <section class="section frame">
    <div class="grid">
      <PostList posts={posts} showSeries={false} />
    </div>
  </section>
</BaseLayout>
