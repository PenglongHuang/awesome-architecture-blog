---
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/urls'
---
<BaseLayout title="页面走丢了">
  <div class="page-head frame">
    <div class="grid">
      <p class="page-head__side">404</p>
      <h1 class="page-head__title">这一页不在图里。</h1>
      <p class="page-head__intro">可能是链接旧了，或者这篇文章还没写。回到地图上重新出发：<a href={href('/')}>回首页</a>，或从<a href={href('/tutorial/')}>第一章</a>读起。</p>
    </div>
  </div>
</BaseLayout>
