---
import '../styles/global.css'
import Masthead from '../components/Masthead.astro'
import Footer from '../components/Footer.astro'
import { messagesFor, localePath, SHARED_PAGES, type Locale } from '../lib/i18n.mjs'
import { href, canonicalUrl } from '../lib/urls'

interface Props {
  locale?: Locale
  alternates?: Partial<Record<Locale, string>>
  title: string
  description?: string
  image?: string
  imageAlt?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
}
const {
  locale = 'zh-CN',
  alternates: providedAlternates,
  title,
  description = messagesFor(locale).description,
  image,
  imageAlt = title,
  ogType = 'website',
  noindex = false,
} = Astro.props
const t = messagesFor(locale)
const siteName = t.siteName
const fullTitle = title === siteName ? title : `${title} · ${siteName}`
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname.startsWith(base) ? `/${Astro.url.pathname.slice(base.length)}` : Astro.url.pathname
const neutralPath = path.replace(/^\/en(?=\/|$)/, '') || '/'
const alternates: Partial<Record<Locale, string>> = providedAlternates ?? (SHARED_PAGES.includes(neutralPath)
  ? { 'zh-CN': href(localePath(neutralPath)), en: href(localePath(neutralPath, 'en')) } : {})
const canonical = canonicalUrl(Astro.url.pathname)
const imageUrl = image && /^https?:\/\//.test(image) ? image : canonicalUrl(image || t.ogImage)
const isSearchPage = neutralPath === '/search/' || neutralPath === '/search'
const shouldNoindex = noindex || isSearchPage || path === '/404.html'
const siteRoot = canonicalUrl(localePath('/', locale))
const organizationRoot = canonicalUrl('/')
const logoUrl = canonicalUrl('brand-mark.svg')
const siteStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${organizationRoot}#organization`,
      name: siteName,
      url: organizationRoot,
      logo: { '@type': 'ImageObject', url: logoUrl },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}#website`,
      name: siteName,
      url: siteRoot,
      inLanguage: locale,
      publisher: { '@id': `${organizationRoot}#organization` },
    },
  ],
}).replace(/</g, '\\u003c')
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={shouldNoindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([language, url]) => <link rel="alternate" hreflang={language} href={canonicalUrl(url!)} />)}
    {alternates['zh-CN'] && alternates.en && <link rel="alternate" hreflang="x-default" href={canonicalUrl(alternates['zh-CN'])} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={href(localePath('/rss.xml', locale))} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={siteStructuredData} />
    <link rel="icon" type="image/svg+xml" href={`${base}brand-mark.svg`} />
    <link rel="stylesheet" href={`${base}theme.css`} />
    <script is:inline src={`${base}theme.js`}></script>
    {!isSearchPage && (
      <script
        type="speculationrules"
        set:html={JSON.stringify({
          prerender: [
            {
              where: { href_matches: href(localePath('/search/', locale)) },
              eagerness: 'moderate',
            },
          ],
        })}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <Masthead locale={locale} alternates={alternates} />
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <script>
      import '../scripts/quiz'
    </script>
  </body>
</html>
