---
import '../styles/global.css'
import Masthead from '../components/Masthead.astro'
import Footer from '../components/Footer.astro'

interface Props { title: string; description?: string }
const { title, description = '专注架构思维的中文知识库:40 章入门教程、31 张架构地图、6 个系统设计、1 门项目课程。' } = Astro.props
const siteName = 'AI架构师之路'
const fullTitle = title === siteName ? title : `${title} · ${siteName}`
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname.replace(base, '/')
const overrideBase = import.meta.env.PUBLIC_CANONICAL_BASE
const overrideSite = import.meta.env.PUBLIC_CANONICAL_SITE
const useOverride = Boolean(overrideBase && overrideSite)
const rawCanonicalBase = useOverride ? overrideBase : base
const canonicalBase = rawCanonicalBase === '/' ? '' : `/${String(rawCanonicalBase).replace(/^\/+|\/+$/g, '')}`
const rawCanonicalSite = String(useOverride ? overrideSite : (Astro.site || 'https://penglonghuang.github.io'))
const canonicalSite = /^https?:\/\//i.test(rawCanonicalSite) ? rawCanonicalSite : `https://${rawCanonicalSite.replace(/^\/+/, '')}`
const canonical = new URL(`${canonicalBase}${path}`, canonicalSite)
const isSearchPage = path === '/search/' || path === '/search'
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=erode@400,401,500,600&display=swap" rel="stylesheet" />
    {!isSearchPage && (
      <script
        type="speculationrules"
        set:html={JSON.stringify({
          prerender: [
            {
              where: { href_matches: `${base}search/` },
              eagerness: 'moderate',
            },
          ],
        })}
      />
    )}
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <Masthead />
    <main><slot /></main>
    <Footer />
    <script>
      import '../scripts/quiz'
      import '../scripts/reveal'
    </script>
  </body>
</html>
