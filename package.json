{
  "name": "awesome-architecture-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind --exclude-selectors \"pre,figure\"",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import": "node scripts/import-content.mjs",
    "import:course": "node scripts/import-course.mjs",
    "validate": "node scripts/validate-content.mjs",
    "deploy:server": "bash scripts/deploy-server.sh",
    "check": "astro check",
    "check:links": "node scripts/check-built-links.mjs",
    "translation:hash": "node scripts/translation-hash.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.1.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
